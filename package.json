  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx sandbox/start.ts",
    "build": "vite build && esbuild sandbox/start.ts --bundle --platform=node --format=esm --packages=external --banner:js=\"import { createRequire } from 'node:module';const require=createRequire(import.meta.url);\" --outfile=dist/sandbox.mjs",
    "start": "node dist/sandbox.mjs",
    "demo:reset": "node sandbox/reset.mjs",
    "demo:verify": "tsx sandbox/verify.ts"
  },
